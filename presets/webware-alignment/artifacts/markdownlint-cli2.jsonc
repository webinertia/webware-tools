// markdownlint-cli2 configuration for aligned packages.
//
// Formatting consistency for documentation: every default rule except two.
//
// Off by design:
//   MD013 line-length       - 1588 findings in webware-console alone, and prose
//                             wrapping is not structural consistency
//   MD060 table-column-style - alignment padding, same reasoning
//
// Out of scope, because these trees are not documentation this package authors:
//   .github/skills/** - spec-kit managed skills, overwritten on a spec-kit update
//   .specify/**       - spec-kit managed templates, same reason
//   plan/**           - working plans and session handoffs, never published
//
// Those trees accounted for 1885 of the 2032 findings measured across the fleet
// before they were excluded, which is churn nobody can act on.
//
// The required workflow runs this by name as the `markdown` job.
{
  "config": {
    "default": true,
    "MD013": false,
    "MD060": false
  },
  "globs": ["**/*.md"],
  "ignores": ["vendor/**", "node_modules/**", ".github/skills/**", ".specify/**", "plan/**"]
}
